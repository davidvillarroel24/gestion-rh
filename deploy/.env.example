# Copiar a deploy/.env y completar. Generar secretos con: openssl rand -hex 32
# deploy/.env NO se sube a git.

DOMINIO=gestion-rh.duckdns.org

POSTGRES_DB=gestionrh
POSTGRES_USER=gestionrh
POSTGRES_PASSWORD=cambiar-por-un-secreto

DJANGO_SECRET_KEY=cambiar-por-un-secreto-largo
DJANGO_DEBUG=0

# --- Solo para correr Django en Windows SIN Docker (con PostgreSQL local) ---
# En Docker (VPS o PC) estas líneas se ignoran: compose fija DB_HOST=db.
# DB_HOST=localhost
# DB_PORT=5433
# DJANGO_DEBUG=1
# GDAL_LIBRARY_PATH=C:\Program Files\QGIS 3.44.12\bin\gdal313.dll
# GEOS_LIBRARY_PATH=C:\Program Files\QGIS 3.44.12\bin\geos_c.dll
